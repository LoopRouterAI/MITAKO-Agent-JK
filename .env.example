# MITAKO 本地验证环境变量示例
# 复制为 .env 后按本地环境填写。不要把真实密钥提交到仓库。

# ========== 核心 LLM ==========
DEFAULT_MODEL_ID=deepseek-v4-flash
SENSENOVA_API_BASE=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=
DEEPSEEK_REASONING_EFFORT=none

# 可选：覆盖本地配额窗口
# DEEPSEEK_RATE_LIMIT_MAX=500
# DEEPSEEK_RATE_LIMIT_WINDOW_SECONDS=18000

# ========== 备用 OpenAI 兼容通道 ==========
OPENAI_API_BASE=https://apihub.agnes-ai.com/v1
OPENAI_API_KEY=
MODEL_NAME=agnes-2.0-flash

# ========== 视觉审核多模态通道 ==========
# 默认主审建议：Gemini 3.5 Flash；其他模型用于兜底或模型选型实验。
BANANAROUTER_API_KEY=
APIYI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
VISUAL_REVIEW_PRIMARY_MODEL=gemini-3.5-flash
VISUAL_REVIEW_FALLBACK_MODELS=gemini-3.1-flash-lite,doubao-seed-2-0-lite-260428,qwen3.5-flash

# ========== 本地服务 ==========
APP_PORT=8000
ALLOW_PORT_FALLBACK=0
MITAKO_BUSINESS_DEMO_API_ENABLED=1
MOCK_API_PORT=8002
MOCK_API_URL=http://localhost:8002

# ========== 鉴权与租户 ==========
# 本地演示可按脚本默认；生产必须开启鉴权并替换 MITAKO_JWT_SECRET。
MITAKO_AUTH_REQUIRED=1
MITAKO_PROTECTED_API_AUTH_REQUIRED=1
MITAKO_DEV_AUTH_BYPASS=0
MITAKO_JWT_SECRET=
MITAKO_SSO_DEMO=0

# ========== 人工客服 / IM 联调 ==========
HANDOFF_BACKEND=hybrid
CHATWOOT_MOCK=1
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# ========== 队列与缓存 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# SLA_WORKER_MODE=celery
# CELERY_BROKER_URL=redis://localhost:6379/1

# 初始化账号：python scripts/seed_auth.py
