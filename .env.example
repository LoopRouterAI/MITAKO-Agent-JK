# MITAKO 本地验证环境变量示例
# 复制为 .env 后按本地环境填写。.env 永不进入 Git 或甲方 ZIP，只进入受控的内部研发包。

# ========== 核心 LLM ==========
DEFAULT_MODEL_ID=deepseek-v4-flash
SENSENOVA_API_BASE=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=
DEEPSEEK_REASONING_EFFORT=none

# 可选：覆盖本地配额窗口
# DEEPSEEK_RATE_LIMIT_MAX=500
# DEEPSEEK_RATE_LIMIT_WINDOW_SECONDS=18000

# ========== 备用 OpenAI 兼容通道 ==========
OPENAI_API_BASE=https://apihub.agnes-ai.com/v1
OPENAI_API_KEY=
MODEL_NAME=agnes-2.0-flash

# ========== 视觉审核多模态通道 ==========
# 默认主审：Gemini 3.5 Flash-Lite；其他模型用于兜底或模型选型实验。
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_AUTH_MODE=auto
VISION_REVIEW_API_KEY=
# 低成本 Gemini 原生通道；只有 Key 和 Base URL 都存在时才启用。
BANANAROUTER_API_KEY=
BANANAROUTER_GEMINI_BASE_URL=https://api.bananarouter.com
BAIDU_API_KEY=
# 百度官方 VOD 是 OpenAI/BCE 签名协议；这里仅填写另行取得的 Gemini 原生兼容端点。
BAIDU_GEMINI_BASE_URL=
APIYI_API_KEY=
APIYI_GEMINI_BASE_URL=https://api.apiyi.com
# 旧变量继续兼容，不建议新部署继续使用。
BROUTER_API_KEY=
VISION_REVIEW_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
VISION_REVIEW_GEMINI_AUTH_MODE=auto
DASHSCOPE_API_KEY=
ARK_API_KEY=
VISUAL_REVIEW_PRIMARY_MODEL=gemini-3.5-flash-lite
VISUAL_REVIEW_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,doubao-seed-2-0-lite-260428,qwen3.5-flash
# 主服务调用视觉执行器的内网地址；分机部署时必须显式配置。
VISUAL_WORKBENCH_URL=http://127.0.0.1:7861
VISUAL_WORKBENCH_PORT=7861
VISUAL_WORKBENCH_PUBLIC_URL=http://127.0.0.1:7861
# 公开报告与媒体 URL 签名。生产环境必须配置高熵随机密钥，禁止提交或写入交付包；留空仅允许本地进程使用随机临时密钥。
VISUAL_REPORT_SIGNING_SECRET=
# 签名 URL 有效期（秒）。留空使用服务内置短时默认值，生产环境按最小必要访问窗口配置。
VISUAL_REPORT_URL_TTL_SECONDS=
# 生产部署设为 1；未配置固定签名密钥时健康检查失败。
VISUAL_REQUIRE_PERSISTENT_SIGNING_SECRET=1
VISUAL_URL_STRICT_DNS_GUARD=1
VISUAL_URL_DIRECT_MAX_MB=300
VISUAL_MAX_UPLOAD_MB=650
VISUAL_MAX_FOLDER_MB=800
VISUAL_MAX_FOLDER_FILES=200
VISUAL_MAX_BATCH_FOLDERS=10
VISUAL_MAX_BATCH_FILES=400
VISUAL_SUPPLEMENTAL_IMAGE_SOFT_LIMIT=40
VISUAL_MAX_SUPPLEMENTAL_IMAGES=200
VISUAL_RUNTIME_MEDIA_DIR=

# ========== 独立审核编排服务 ==========
REVIEW_JOB_WORKERS=2
REVIEW_ASSET_SOFT_LIMIT=40
REVIEW_MAX_ASSETS=200
REVIEW_MINOR_SCHEMA_RETRIES=2
REVIEW_MAX_ASSET_MB=650
REVIEW_MAX_CASE_MB=750
REVIEW_JOB_TIMEOUT_SECONDS=3600
REVIEW_WORKBENCH_RETRIES=2
REVIEW_ADAPTIVE_MAX_FRAMES=24
# 单任务分段并发，范围 1-4；需按供应商限流压测，当前交付基线为 4。
REVIEW_CHUNK_WORKERS=4
# 单次供应商请求时限与软失败重试。总任务仍由 REVIEW_JOB_TIMEOUT_SECONDS 约束。
REVIEW_MODEL_TIMEOUT_SECONDS=180
REVIEW_MODEL_RETRIES=1
# 连续性通道逐张发送带帧号/时间戳的 JPEG，最多 24 张/请求；不依赖供应商 Files API。
REVIEW_CONTINUITY_FRAMES_PER_CALL=24
REVIEW_PRODUCT_DAMAGE_MAIN_MAX_FRAMES=48
# 官方商品图只在当前审核任务中按需读取，不执行全量下载；默认单任务最多 6 张，硬上限 12 张。
REVIEW_PRODUCT_IMAGE_BASE_URL=https://cdn-qiniu.danhaotuan.com/storage/mnt/zhonggu/
REVIEW_PRODUCT_IMAGE_ALLOWED_HOSTS=cdn-qiniu.danhaotuan.com
REVIEW_PRODUCT_IMAGE_LIMIT=6
REVIEW_PRODUCT_IMAGE_CACHE_DIR=
REVIEW_PRODUCT_IMAGE_MAX_BYTES=8388608
REVIEW_PRODUCT_IMAGE_MAX_PIXELS=20000000
REVIEW_PRODUCT_IMAGE_MAX_EDGE=1280
REVIEW_PRODUCT_IMAGE_JPEG_QUALITY=82
REVIEW_PRODUCT_IMAGE_MAX_SEGMENTS=3
REVIEW_PRODUCT_IMAGE_DNS_TIMEOUT_SECONDS=3
REVIEW_PRODUCT_IMAGE_CACHE_TTL_SECONDS=604800
REVIEW_PRODUCT_IMAGE_CACHE_MAX_MB=512
# 可选非 AI 媒体取证；部署机安装 ffprobe 后生效，超时只降级取证、不伪造结论。
REVIEW_FFPROBE_PATH=
REVIEW_FFPROBE_TIMEOUT_SECONDS=20
# 兼容旧配置；当前抽帧始终覆盖完整视频时轴，不再只扫描开头窗口。
REVIEW_PROBE_SECONDS=12

# ========== 本地服务 ==========
APP_PORT=8000
ALLOW_PORT_FALLBACK=0
MITAKO_BUSINESS_DEMO_API_ENABLED=1
MOCK_API_PORT=8002
MOCK_API_URL=http://localhost:8002

# ========== 鉴权与租户 ==========
# 本地演示可按脚本默认；生产必须开启鉴权并替换 MITAKO_JWT_SECRET。
MITAKO_AUTH_REQUIRED=1
MITAKO_PROTECTED_API_AUTH_REQUIRED=1
MITAKO_DEV_AUTH_BYPASS=0
MITAKO_JWT_SECRET=
MITAKO_SSO_DEMO=0

# ========== VIP客服 / IM 联调 ==========
HANDOFF_BACKEND=hybrid
CHATWOOT_MOCK=1
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# ========== 队列与缓存 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# SLA_WORKER_MODE=celery
# CELERY_BROKER_URL=redis://localhost:6379/1
# 审核任务租约到期后的周期回收间隔，10-300 秒。
REVIEW_RECOVERY_INTERVAL_SECONDS=30

# 初始化账号：python scripts/seed_auth.py
