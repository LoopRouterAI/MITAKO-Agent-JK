# 默认 LLM 模型 ID（deepseek-v4-flash | agnes-2.0-flash）
DEFAULT_MODEL_ID=deepseek-v4-flash

# 统一审核链（Persona + 冒险安全）— 默认 DeepSeek V4 Flash + SENSENOVA_API_KEY
# COMPANION_REVIEW_MODEL=deepseek-v4-flash
# ADVENTURE_REVIEWER_MODEL=deepseek-v4-flash  # 可单独覆盖冒险审核

# DeepSeek V4 Flash — SenseNova 平台
# POST https://token.sensenova.cn/v1/chat/completions  model=deepseek-v4-flash
# 配额：每 5 小时 500 次（程序内滑动窗口追踪，见 llm_rate_limit.py）
SENSENOVA_API_KEY=your_sensenova_api_key_here
SENSENOVA_API_BASE=https://token.sensenova.cn/v1
# 客服 Agent 建议 none 关闭思考模式；复杂推理可设 high
DEEPSEEK_REASONING_EFFORT=none
# 可选：覆盖默认配额窗口（秒）与上限（次）
# DEEPSEEK_RATE_LIMIT_MAX=500
# DEEPSEEK_RATE_LIMIT_WINDOW_SECONDS=18000

# SenseNova U1 Fast 信息图（共用 SENSENOVA_API_KEY，每 5 小时 1500 次）
# SENSENOVA_U1_DEFAULT_SIZE=2752x1536
# SENSENOVA_U1_RATE_LIMIT_MAX=1500
# SENSENOVA_U1_RATE_LIMIT_WINDOW_SECONDS=18000

# Agnes 生图兜底（共用 OPENAI_API_KEY / AGNES_API_KEY）
# AGNES_API_KEY=
# AGNES_API_BASE=https://apihub.agnes-ai.com/v1
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# 冒险配图管线
# ADVENTURE_ILLUST_PRIMARY=sensenova-u1-fast
# ADVENTURE_ILLUST_FALLBACK=agnes-image-2.1-flash
# ADVENTURE_ILLUST_COOLDOWN_TURNS=2
# ADVENTURE_ILLUST_MAX_PER_SESSION=40
# ADVENTURE_CONTEXT_TOKEN_BUDGET=128000
# ADVENTURE_CONTEXT_COMPRESS_THRESHOLD=100000
# ADVENTURE_RECENT_FULL_TURNS=8

# Agnes-2.0-Flash 备用
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://apihub.agnes-ai.com/v1
MODEL_NAME=agnes-2.0-flash

# 多模态模型配置（推荐Qwen3.5-Flash模型优先、Doubao-Seed-2.0-Lite和Gemini 3.1 Flash-Lite兜底，三个模型成本也是按顺序增高的）
# 1. 阿里通义千问 API 密钥 (用于 Qwen3.5-Flash 模型，但此模型不支持音频理解)
# 获取地址: https://bailian.console.aliyun.com/
# 注意: 这不是 AccessKey_ID，而是百炼平台专用的 API Key (格式: sk-xxx)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 2. APIYI 代理平台 API 密钥 (用于 Gemini 3.1 Flash-Lite 模型及 E2E 语义评估模型)
# 获取地址: https://api.apiyi.com/
APIYI_API_KEY=your_apiyi_api_key_here

# 3. 字节跳动火山引擎 Ark 密钥 (用于 Doubao 模型，如：Doubao-Seed-2.0-Lite)
# 获取地址: https://console.volcengine.com/ark
ARK_API_KEY=your_volcengine_ark_key_here
# 注意：字节跳动火山引擎的 endpoint 通常需要特定模型接入点 ID，配置在 MODEL_CONFIG 的 model 字段中

# Redis 缓存配置（用于情绪滑动窗口与CD限制）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 本地 Mock 业务 API 已合并进 main.py（同端口），无需单独启动 mock_api
# 若需独立 Mock 服务调试，可运行: python mock_api.py （默认 8002）
MOCK_API_PORT=8002
MOCK_API_URL=http://localhost:8002

# 主 App 端口（默认 8000；设 ALLOW_PORT_FALLBACK=1 时端口占用自动递增）
APP_PORT=8000
ALLOW_PORT_FALLBACK=0

# ========== 009/010 鉴权与安全（生产必读 docs/security/production-checklist.md）==========
# 本地/E2E 默认 0；生产必须 1
MITAKO_AUTH_REQUIRED=0
# 生产必须替换为随机长密钥（≥32 字符），禁止默认值
MITAKO_JWT_SECRET=mitako-dev-change-me-in-production
# Companion C 端 token；留空则跟随 MITAKO_AUTH_REQUIRED
# MITAKO_COMPANION_AUTH_REQUIRED=1

# 010 多租户 SSO — 生产默认关闭 Demo（对接见 docs/integration/sso-oidc-guide.md）
MITAKO_SSO_DEMO=0
# 本地 Demo 联调时可设 MITAKO_SSO_DEMO=1

# 010 IM/工单 — Chatwoot（对接见 docs/integration/chatwoot-guide.md）
# HANDOFF_BACKEND=hybrid
CHATWOOT_MOCK=1
# 甲方自建 Chatwoot API 根地址（勿用 chatwoot.com 官方 SaaS 作为生产地址）
# CHATWOOT_BASE_URL=https://im.your-company.com
# CHATWOOT_API_TOKEN=
# CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_INBOX_ID=1

# 010 SLA 分布式 Worker
# SLA_WORKER_MODE=celery
# CELERY_BROKER_URL=redis://localhost:6379/1

# 初始化账号（含 comp_ops / companion_ops）: python scripts/seed_auth.py
