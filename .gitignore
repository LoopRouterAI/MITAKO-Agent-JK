# MITAKO Agent 本地开发忽略项

# 运行环境与依赖
venv/
.venv/
node_modules/
__pycache__/
*.py[cod]
*$py.class

# 本地配置与密钥
.env
.env.*
!.env.example

# 本地数据库、运行时记忆、缓存
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite3
data/chat_attachments/
data/private_domain_uploads/
data/review_jobs/
viking_memory/
tmp/
scratch/
logs/

# 本地索引与工具状态
.codegraph/
.cursor/
archive/

# 测试与演示产物
tests/reports/*.html
!tests/reports/customer_chat_acceptance_*.html
tests/reports/*.md
!tests/reports/customer_chat_acceptance_*.md
