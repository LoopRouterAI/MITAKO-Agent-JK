upstream mitako_main {
    server 127.0.0.1:8015;
    keepalive 32;
}

server {
    listen 80;
    server_name agent.example.internal;

    access_log /var/log/nginx/mitako-review-access.log combined;
    error_log /var/log/nginx/mitako-review-error.log warn;

    location /api/v1/review/jobs {
        client_max_body_size 800m;
        client_body_timeout 1800s;
        proxy_request_buffering off;
        proxy_send_timeout 1900s;
        proxy_read_timeout 1900s;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://mitako_main;
    }

    location / {
        client_max_body_size 32m;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://mitako_main;
    }
}
